# ============================================================
# Conexión al Omada Controller (Open API - modo Authorization Code)
# ============================================================
# Documentación oficial: https://omada-northbound-docs.tplinkcloud.com/
# Crea la app en el controlador en:
#   Global View > Settings > Platform Integration > Open API > Add New App
#     - Access mode: Authorization Code
#     - Redirect URL: no se usa en este flujo (el login se hace directo por API,
#       no por navegador), puedes poner cualquier valor válido, p.ej. http://localhost
#
# Tras crear la app, el controlador te muestra 5 datos. Aquí el mapeo exacto:
#
#   Campo en el controlador        -> Variable de abajo
#   ------------------------------------------------------------
#   Interface Access Address       -> OMADA_BASE_URL
#   Omada ID                       -> OMADA_OMADAC_ID
#   Client ID                      -> OMADA_CLIENT_ID
#   Client Secret                  -> OMADA_CLIENT_SECRET
#   Oauth Login Page Address       -> OMADA_OAUTH_LOGIN_PAGE_ADDRESS (opcional,
#                                      solo informativo: es la URL de login por
#                                      NAVEGADOR de un redirect OAuth clásico;
#                                      este portal hace el login directo por API
#                                      y no la necesita para funcionar)

OMADA_BASE_URL=https://tu-controlador.tudominio.com:8043
OMADA_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OMADA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OMADA_OMADAC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional, solo para referencia (ver nota arriba):
OMADA_OAUTH_LOGIN_PAGE_ADDRESS=

# Cuenta de servicio del controlador (usuario Omada con permisos de vista
# sobre Sites y de modificación sobre Hotspot/Usuarios Locales), usada para
# el paso de "login" del flujo Authorization Code.
# Recomendado: crear un usuario dedicado, NO el súper-admin del controlador.
OMADA_CONTROLLER_USERNAME=api-service-account
OMADA_CONTROLLER_PASSWORD=cambia-esto

# Pon "false" solo si el controlador usa un certificado autofirmado (no recomendado en producción)
OMADA_VERIFY_SSL=true
OMADA_REQUEST_TIMEOUT=15
OMADA_MIN_REQUEST_INTERVAL=0.15

# ============================================================
# Portal (Streamlit)
# ============================================================
# Cadena aleatoria larga, única por instalación (ej: `openssl rand -hex 32`)
APP_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOG_LEVEL=INFO

# Rutas de datos locales (opcional, los valores por defecto ya son válidos)
# APP_DB_PATH=./data/portal.duckdb
# OMADA_TOKEN_CACHE_PATH=./data/.omada_token_cache.json
